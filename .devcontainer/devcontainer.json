{
  "name": "PubCoDatabaseLocal",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bullseye",
  "runArgs": ["--env-file", ".env"],
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
